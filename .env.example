# Copy to backend/.env for local development.

JWT_SECRET=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///./data/finmate.db

# OpenAI-compatible chat API. Leave LLM_API_KEY empty to keep chat and
# AI report commentary disabled. The rest of FinMate still works.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: send a single uncategorised description to the LLM.
# Bulk CSV import never calls the LLM.
LLM_CATEGORIZE_FALLBACK=false

CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
